# 依赖
node_modules/

# 构建产物（由 `npm run build` 生成，部署时由 Worker 的 assets 绑定上传）
apps/web/dist/

# 发布包（scripts/package-release.mjs 生成，走 GitHub Release 附件分发，不入库）
release/

# wrangler 本地状态（含 dev 环境的 KV 数据，可能带真实订阅/令牌）
apps/server/.wrangler/

# 临时工作区，可随时删。用通配而不是逐个列目录 —— 漏一个就会把临时文件带进提交。
#   .tmp-logo/    logo 换色的方案对比（正式资产在 apps/web/public/，
#                 重新生成走 `python scripts/gen-logo.py <原始.svg>`）
#   .tmp-formats/ 目标格式全量探测等一次性排查脚本与产物
.tmp-*/

# 排查 SCE 接口时从它源码里导出的 .cpp（属 SubConverter-Extended，GPL-3.0）。
# 本项目只是通过 HTTP 调用它，**不包含也不发布它的源码** —— 一旦混进仓库，
# NOTICE 里「外部服务、不含源码」的声明就不成立了。
_sce_*.cpp

# 运维记录：含真实域名、Cloudflare 账号 / zone id、部署与换域名历史。
# 本地保留供自查，不随仓库发布。
DEPLOY.md

# 线上冒烟脚本：BASE 指向作者自己的线上实例，对使用者没有意义。
scripts/smoke-online.mjs

# 本地验证 / 截图脚本：只服务于本机开发，不随仓库发布。
#   · verify*.mjs      接口 / 算子 / 存储 / 安全 等回归脚本
#   · shots*.mjs       逐页截图（产物 shots/ 只留本地，同样不入库）
#   · probe-feed.mjs   临时排查用的探测脚本
# 注意 scripts/package-release.mjs 与 gen-logo.py **不在**排除范围内 ——
# 前者是发布打包脚本，后者用于重新生成 logo，两者都要留在仓库里。
scripts/verify*.mjs
scripts/shots.mjs
scripts/shot-ai.mjs
scripts/probe-feed.mjs

# 截图产物：只留本地，不入库。需要展示时自行生成后再决定是否单独提供。
shots/

# 凭据 —— 永不入库。访问令牌走 `wrangler secret put`，API Key 走 shell 环境变量。
.env
.env.*
# 但模板要入库，否则使用者不知道要填哪些变量
!.env.example
*.pem
*.key

# Node / Docker 部署的本地数据（SQLite）。生产数据在这里，别提交。
apps/server/data/
/data/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
